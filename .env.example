# QuickDrop Environment Configuration

# ── Frontend (Vite) ──────────────────────────────────────────────────────────

# WebSocket Signaling Server URL
# Local dev: leave blank — uses the embedded Vite WS server at /quickdrop-ws
# Production (Netlify / Vercel): set to your deployed Railway / Render / Fly.io URL
# IMPORTANT: use wss:// (not ws://) for HTTPS-hosted frontends
VITE_SIGNALING_SERVER_URL=

# Optional custom STUN/TURN servers (comma-separated)
# VITE_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302


# ── Signaling Server (server/signaling-server.js) ────────────────────────────

# Port the signaling server listens on (Railway / Render inject PORT automatically)
PORT=4000

# Origin restriction — comma-separated list of allowed frontend origins.
# Set to your Netlify/Vercel domain to prevent unauthorized clients from
# using your signaling server.
# Leave blank or set to * to allow all origins (local dev / open mode).
#
# Example:
# ALLOWED_ORIGINS=https://quickdrop.netlify.app,https://your-custom-domain.com
ALLOWED_ORIGINS=*
